# ============================================
# Learningfy - Template Environment
# Copy file ini menjadi .env lalu isi:
#   cp .env.example .env
# ============================================

# --- Backend ---
NODE_ENV=production
# WAJIB ADA — kalau kosong, backend fallback ke port 5000
PORT=4000

# PostgreSQL server homelab.
# Buat database dulu di server:
#   docker exec postgres psql -U admin -d postgres -c "CREATE DATABASE learningfy OWNER admin;"
PG_URI=postgresql://admin:PASSWORD@postgres:5432/learningfy

# Secret JWT — generate sendiri, contoh:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
JWT_SECRET=ganti_dengan_secret_acak_panjang

# Origin frontend yang diizinkan CORS (pisahkan dengan koma).
# Tambahkan domain/IP server produksi, contoh: http://192.168.1.10:3010
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3010

# --- Midtrans (sandbox untuk demo/portfolio) ---
MIDTRANS_SERVER_KEY=isi_server_key_sandbox
MIDTRANS_CLIENT_KEY=isi_client_key_sandbox
